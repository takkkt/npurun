{
  "version": 4,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "npurun release (clang, Ninja, Zen 5)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "LLAMA_BUILD_TESTS": "OFF",
        "GGML_OPENMP": "OFF",
        "GGML_NATIVE": "OFF",
        "GGML_AVX": "ON", "GGML_AVX2": "ON", "GGML_FMA": "ON", "GGML_F16C": "ON", "GGML_BMI2": "ON",
        "GGML_AVX_VNNI": "ON", "GGML_AVX512": "ON", "GGML_AVX512_VBMI": "ON",
        "GGML_AVX512_VNNI": "ON", "GGML_AVX512_BF16": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" }
  ]
}
